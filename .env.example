# Copy to .env (never commit it). refresh.sh loads it.
TALLY_API_KEY=            # tally.so -> Settings -> API keys
TALLY_FORM_ID=            # from the form URL: tally.so/forms/<ID>
GITHUB_TOKEN=             # fine-grained token; read-only "Metadata" (+ "Administration: read" for traffic)
GITHUB_REPOS=OpenMS/OpenMS
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=         # right-click server -> Copy Server ID (developer mode on)
DISCORD_BACKFILL_DAYS=180
# Where the rendered site is copied to (served by nginx/Caddy behind auth)
DEPLOY_DIR=/var/www/openms-dashboard
