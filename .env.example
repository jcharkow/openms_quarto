# Copy to .env (never commit it). refresh.sh loads it.
# tally.so -> Settings -> API keys
TALLY_API_KEY=
# from the form URL: tally.so/forms/<ID>
TALLY_FORM_ID=
# fine-grained token, Repository access: Public repositories (read-only); see README
GITHUB_TOKEN=
# Repos for the GitHub pages and the funder KPIs. Tag each with the service package(s) it counts
# towards: core, python, webapps, workflows (see FUNDER_METRICS.md). Untagged repos still count
# in the per-repo and "all tracked repos" tables. Keep the quotes: refresh.sh sources this file
# with bash, and an unquoted "|" would be read as a pipe.
GITHUB_REPOS="OpenMS/OpenMS=core|python,OpenMS/pyopenms_viz=python,OpenMS/streamlit-template=webapps,bigbio/quantms=workflows,nf-core/mhcquant=workflows"
# first commit date to backfill; default 1 January three years ago
GITHUB_COMMITS_SINCE=
# Package downloads (ingest.packages): public Bioconda + PyPI data, same name=service syntax
BIOCONDA_PACKAGES="libopenms=core,openms=core,openms-thirdparty=core,pyopenms=python"
PYPI_PACKAGES="pyopenms=python,pyopenms-viz=python"
# default 1 January three years ago
PACKAGES_SINCE=
# developer portal -> your app -> Bot -> Reset Token (see README)
DISCORD_BOT_TOKEN=
# right-click server -> Copy Server ID (developer mode on)
DISCORD_GUILD_ID=
DISCORD_BACKFILL_DAYS=180
# Quarto binary if it's not on PATH, e.g. from a conda env (no need to activate conda then)
QUARTO=
# Python to use instead of the auto-created .venv (optional)
PYTHON=
# Where the rendered site is copied to (served by nginx/Caddy behind auth)
DEPLOY_DIR=/var/www/openms-dashboard
